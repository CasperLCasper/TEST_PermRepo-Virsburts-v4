# ---------------------------------------------------------------------------
# v14 — jaunie iestatījumi / new settings / novaj agordoj
# ---------------------------------------------------------------------------

# Public RPC URL returned to browsers (wallet_addEthereumChain). Never put a keyed RPC here.
# Publiskais RPC, ko atdod pārlūkam. RPC_URL var saturēt API atslēgu — to klientam neatdod.
# Publika RPC por retumiloj. RPC_URL povas enhavi API-ŝlosilon — ne donu ĝin al la kliento.
# PUBLIC_RPC_URL="https://sepolia.base.org"

# Arweave data verification before the wallet signature (seconds-level timeouts; client retries).
# Arweave datu pārbaude pirms maka paraksta (īsi taimauti; klients atkārto).
# MANIFEST_VERIFY_TIMEOUT_MS=15000
# MANIFEST_VERIFY_ATTEMPTS=2

# How many previous ZIP archives are probed in parallel when deciding "unchanged" files.
# Cik iepriekšējo ZIP vienlaikus pārbauda, nosakot "nemainītos" failus.
# ZIP_AVAILABILITY_CONCURRENCY=4

# Repository -> job index. While true, the emergency purge also scans all Redis keys
# (needed for jobs created before the index existed). Safe to leave true; set false when Redis is large.
# Repo -> job indekss. Kamēr true, avārijas dzēšana papildus skenē visu Redis (vecie job).
# Droši atstāt true; uz false pārslēdz tikai tad, ja Redis ir liels.
# JOB_INDEX_LEGACY_SCAN=true
# REPO_JOBS_INDEX_TTL_SECONDS=34560000
# JOB_INDEX_TOUCH_INTERVAL_MS=60000

# Base mainnet (CHAIN_ID=8453) REFUSES to start with REQUIRE_ANS104_LOCATION=false.
# Base mainnet (CHAIN_ID=8453) NEATĻAUJ startēt ar REQUIRE_ANS104_LOCATION=false.
# Base ĉefreto (CHAIN_ID=8453) NE ebligas komencon kun REQUIRE_ANS104_LOCATION=false.

# Set to true ONLY after deploying PermRepoSubscription v2 (has subscribeWithMaxPrice). Old contracts: leave false.
# Uz true tikai pēc PermRepoSubscription v2 izvietošanas (satur subscribeWithMaxPrice). Vecam līgumam atstājiet false.
# SUBSCRIPTION_SUPPORTS_MAX_PRICE=false

# F-05: which Merkle root NEW backups use. Old manifests are always accepted.
# 1 = file hash only (works with old restore pages); 2 = path + hash + ZIP ID + deleted files (needs restore v2).
# Kuru Merkle versiju izmanto JAUNIE backup. Vecie manifesti vienmēr tiek pieņemti.
# 1 = tikai faila hash (der vecai restore lapai); 2 = ceļš + hash + ZIP ID + dzēstie faili (vajag restore v2).
# MANIFEST_MERKLE_VERSION=1

# S-04: allow backup of ARCHIVED repositories (default true). Set false to restore the old behaviour.
# Atļaut ARHIVĒTU repozitoriju backup (pēc noklusējuma true).
# ALLOW_ARCHIVED_REPOSITORIES=true

# F-07: GitHub authorisation mode.
#   oauth (default) — OAuth App, scope=repo (full read/WRITE access to the user's private repositories).
#   app             — GitHub App with Repository permissions: Contents = Read-only, Metadata = Read-only.
# For app mode: create a GitHub App, enable "Expire user authorization tokens", set the callback URL to
# GITHUB_REDIRECT_URI, use its Client ID/Secret as GITHUB_CLIENT_ID/GITHUB_CLIENT_SECRET, and set the slug below.
# app režīmam: izveidojiet GitHub App, ieslēdziet "Expire user authorization tokens", callback URL = GITHUB_REDIRECT_URI.
# GITHUB_AUTH_MODE=oauth
# GITHUB_APP_SLUG=

# Memory budget: the server uses the CONTAINER memory limit (cgroup), not the host's RAM. Override only if detection is wrong.
# Atmiņas budžets: serveris izmanto konteinera limitu (cgroup), nevis hosta RAM. Pārrakstiet tikai, ja noteikšana kļūdaina.
# RESOURCE_TOTAL_MEMORY_BYTES=2147483648
